<Project>
  <PropertyGroup>
    <KniVersion>4.3.9001</KniVersion>
    <!-- Default version for local and CI builds of the SkiaGameRendering.* packages. It is NOT the
         released version: publish.yml overrides it with its `version` input, so this value goes stale.
         Look up the last published version on NuGet (see CLAUDE.md "Releasing"). -->
    <LibraryVersion>0.1.1</LibraryVersion>
    <!-- Must match whatever nkast.Wasm.* version the pinned KniVersion actually depends on (check
         that KNI package's own nuspec - it changes between KNI releases, e.g. 4.2.9001 -> 8.0.11,
         4.3.9001 -> 10.0.3). samples/Sample.Kni.WebGL/wwwroot/index.html and
         samples/Sample.Gum.Kni.WebGL/wwwroot/index.html hardcode this same version in their
         <script> tags and must be updated in lockstep - a mismatch 404s at runtime instead of
         failing the build, and KNI's own bootstrap crashes when it calls into the JS interop
         globals those scripts were supposed to define. See repo issue #14. -->
    <NkastWasmCanvasVersion>10.0.3</NkastWasmCanvasVersion>
    <SkiaSharpVersion>4.153.1</SkiaSharpVersion>
    <!-- 4.4.1 is pinned deliberately: 4.4 is the first Stride version whose D3D11
         backend is Silk.NET rather than SharpDX, which is what makes GraphicsDevice.NativeDevice a
         public ComPtr<ID3D11Device> - Stride 4.3 still wraps D3D11 in
         SharpDX and keeps NativeDevice non-public. See src/SkiaGameRendering.Stride's docs for the
         full comparison. Must match whatever Stride.CommunityToolkit.* version samples/Sample.Stride
         depends on. 4.4.1 also fixes a missing COLOR_ATTACHMENT_READ in Stride's Vulkan render target
         barrier (issue #122). -->
    <StrideVersion>4.4.1</StrideVersion>
    <StrideCommunityToolkitVersion>1.0.0-preview.68</StrideCommunityToolkitVersion>
    <!-- Must match the Silk.NET version Stride.Graphics 4.4.1 itself depends on (check that
         package's own nuspec on a Stride version bump) - SkiaGameRendering.Stride names
         Silk.NET.Direct3D11/Core types directly (ComPtr<ID3D11Device>, ID3D11Resource*). -->
    <SilkNetVersion>2.23.0</SilkNetVersion>
    <!-- Must match the Vortice.Vulkan version Stride.Graphics 4.4.1 itself depends on (check
         that package's own nuspec on a Stride version bump) - SkiaGameRendering.Stride.VK names
         Vortice.Vulkan's VkInstance/VkPhysicalDevice/VkDevice/VkQueue/VkImage types directly, the
         same reasoning SilkNetVersion above documents for the D3D11 adapter. -->
    <VorticeVulkanVersion>3.0.3</VorticeVulkanVersion>
    <!-- GodotSharp is Godot's C# core API, published to NuGet per engine release; 4.7.2 is the
         current stable. This is a floor (>=), not a pin: a game on a newer Godot resolves its own
         Godot.NET.Sdk's GodotSharp and NuGet unifies upward. samples/Sample.Godot's csproj names
         the same version in its Sdk attribute (which cannot read an MSBuild property) - bump both. -->
    <GodotSharpVersion>4.7.2</GodotSharpVersion>
  </PropertyGroup>
</Project>
