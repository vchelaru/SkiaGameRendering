<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- The same native runtime package the sample references, so the test sees the mgruntime.dll a game ships.
         Keep its version equal to the sample's (samples/Sample.MonoGame.WindowsDX12). -->
    <PackageReference Include="MonoGame.Runtime.Windows.DX12" Version="3.8.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SkiaGameRendering.WindowsDX12\SkiaGameRendering.WindowsDX12.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\EngineReflectionPin.cs" Link="EngineReflectionPin.cs" />
  </ItemGroup>
</Project>
