<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SkiaGameRendering.Raylib.OGL\SkiaGameRendering.Raylib.OGL.csproj" />
  </ItemGroup>

  <!--
    No MesaVendor.props import here, unlike Tests.Core.OGL.csproj: LinuxOnlyFactAttribute skips the
    one test in this project before it ever touches GL on Windows, so windows-latest never needs a
    software GL driver for it. See that attribute's doc comment for why Windows raylib coverage is
    deferred instead of wired up now.
  -->
  <ItemGroup>
    <Compile Include="..\Shared\GoldenScene.cs" Link="GoldenScene.cs" />
    <Compile Include="..\Shared\GoldenImage.cs" Link="GoldenImage.cs" />
    <Content Include="goldens\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
