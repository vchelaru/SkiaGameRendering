<!--
  Traversal project so CI does not have to name each test project by hand. `dotnet test tests/Tests.proj`
  discovers every csproj under tests/ at evaluation time, so adding a test project is enough to get it
  running in CI. Naming projects explicitly is how a new test project ends up silently never running.

  tests/Tests.Kni.WebGL is a Playwright suite with no csproj, so the glob skips it. It runs in its own
  workflow job.
-->
<Project Sdk="Microsoft.Build.Traversal/4.1.0">

  <!--
    Traversal defaults to BuildInParallel=true. Every project pinned to StrideVersion (all four
    Stride.* projects, via eng/Versions.props) shares one build-time temp path for Stride.Core's
    AssemblyProcessor tool copy (Stride.Core.targets: StrideAssemblyProcessorTempBasePath is keyed
    by a hash of the tool binary, not per-project) and that copy is an unguarded
    Condition="!Exists(...)" check with no lock. Two of those projects building at once race on it -
    one MSBuild node wins the copy, the other hits MSB3027/"used by another process". Serializing the
    whole traversal is the simplest fix that can't miss a future project hitting the same shared
    path; it costs CI wall-clock (no more parallel project builds) in exchange for not racing.
  -->
  <PropertyGroup>
    <BuildInParallel>false</BuildInParallel>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)**\*.csproj" />
  </ItemGroup>

</Project>
