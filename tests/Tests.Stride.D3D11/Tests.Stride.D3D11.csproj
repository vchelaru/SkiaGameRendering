<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\eng\Versions.props" />
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SkiaGameRendering.Stride.D3D11\SkiaGameRendering.Stride.D3D11.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\EngineReflectionPin.cs" Link="EngineReflectionPin.cs" />
    <Compile Include="..\Shared\StrideTestParallelism.cs" Link="StrideTestParallelism.cs" />
    <Compile Include="..\Shared\GoldenScene.cs" Link="GoldenScene.cs" />
    <Compile Include="..\Shared\GoldenImage.cs" Link="GoldenImage.cs" />
    <Compile Include="..\Shared\StrideSkiaGolden.cs" Link="StrideSkiaGolden.cs" />
    <Content Include="goldens\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!--
      StrideSkiaGolden.cs is shared with Tests.Stride.VK, whose render-target type has a different
      name but the same members. Aliasing each backend's own type to one name here is what lets the
      shared file name it - see that file's doc comment.
    -->
    <Using Include="SkiaGameRendering.Stride.D3D11.SkiaStrideRenderTarget2D" Alias="SkiaStrideCanvas" />
  </ItemGroup>
</Project>
