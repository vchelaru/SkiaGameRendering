<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WasmBuildNative>true</WasmBuildNative>
    <EmccExtraLDFlags>-sMIN_WEBGL_VERSION=2 -sMAX_WEBGL_VERSION=2 -sFULL_ES3=1</EmccExtraLDFlags>
    <FnaWasmLibs Condition="'$(FnaWasmLibs)' == ''">$(MSBuildThisFileDirectory)....externalnalibs-wasm</FnaWasmLibs>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\external\FNA\FNA.Core.csproj" />
    <NativeFileReference Include="$(FnaWasmLibs)\SDL2.a" />
    <NativeFileReference Include="$(FnaWasmLibs)\FNA3D.a" />
    <NativeFileReference Include="$(FnaWasmLibs)\mojoshader.a" />
  </ItemGroup>
</Project>
