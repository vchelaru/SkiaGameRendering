<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <Import Project="..\..\eng\Versions.props" />
  <PropertyGroup>
    <!-- net10, not net8: Emscripten's version must match the .NET runtime's, and SDL2 and FNA3D are built with 3.1.56 (see eng/build-fna-wasm-natives.sh). -->
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WasmBuildNative>true</WasmBuildNative>
    <!-- FNA is not trim-clean (IL2026 and friends in its own sources), so those warnings cannot fail the publish. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <TrimmerSingleWarn>true</TrimmerSingleWarn>
    <EmccExtraLDFlags>-sMIN_WEBGL_VERSION=2 -sMAX_WEBGL_VERSION=2 -sFULL_ES3=1</EmccExtraLDFlags>
    <FnaWasmLibs Condition="'$(FnaWasmLibs)' == ''">$(MSBuildThisFileDirectory)..\..\external\fnalibs-wasm</FnaWasmLibs>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\SkiaGameRendering.Fna.WebGL\SkiaGameRendering.Fna.WebGL.csproj" />
    <ProjectReference Include="..\..\external\FNA\FNA.Core.csproj" />
    <NativeFileReference Include="$(FnaWasmLibs)\SDL2.a" />
    <NativeFileReference Include="$(FnaWasmLibs)\FNA3D.a" />
    <NativeFileReference Include="$(FnaWasmLibs)\mojoshader.a" />
  </ItemGroup>
  <Import Project="..\Shared\Scene.props" />
</Project>
