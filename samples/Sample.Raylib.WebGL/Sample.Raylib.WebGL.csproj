<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <Import Project="..\..\eng\Versions.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <BlazorEnableTimeZoneSupport>false</BlazorEnableTimeZoneSupport>
    <!-- The .NET 10 SDK's Emscripten 3.1.56 runs a wasm-opt that rejects the enable-bulk-memory-opt flag the SDK passes
         it (emcc fails at the link). The O0 setting skips wasm-opt; this sample is only the pixel-test host, so size does not matter. -->
    <EmccLinkOptimizationFlag>-O0</EmccLinkOptimizationFlag>
  </PropertyGroup>

  <!-- A NuGet consumer gets this file from the package; the sample references the project, so it imports it. -->
  <Import Project="..\..\src\SkiaGameRendering.Raylib.WebGL\build\SkiaGameRendering.Raylib.WebGL.props" />

  <ItemGroup>
    <ProjectReference Include="..\..\src\SkiaGameRendering.Raylib.WebGL\SkiaGameRendering.Raylib.WebGL.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.*" PrivateAssets="all" />
  </ItemGroup>

  <Import Project="..\Shared\Scene.props" />
</Project>
