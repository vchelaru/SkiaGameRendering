<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Selects the WindowsDX12 native platform out of MonoGame.Framework.Native's multi-platform
         package - required by MonoGame.Content.Builder.Task.targets even with no content to build. -->
    <MonoGamePlatform>WindowsDX12</MonoGamePlatform>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationManifest>..\Sample.MonoGame.WindowsDX\app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Sample.MonoGame.WindowsDX\Icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    Uses MonoGame/MonoGame#9536 and #9535 (GetNativeHandles / RenderTarget2D.FromNativeHandle), shipped in
    3.8.6-preview.2. The native mgruntime.dll comes from the separate MonoGame.Runtime.Windows.DX12 package.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\Sample.MonoGame.WindowsDX\Icon.ico" Link="Icon.ico" />
    <EmbeddedResource Include="..\Sample.MonoGame.WindowsDX\Icon.bmp" Link="Icon.bmp" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.Native" Version="3.8.6-preview.2" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.6-preview.2" />
    <PackageReference Include="MonoGame.Runtime.Windows.DX12" Version="3.8.6-preview.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\SkiaGameRendering.Core.D3D12\SkiaGameRendering.Core.D3D12.csproj" />
  </ItemGroup>
  <Target Name="RestoreDotnetTools" BeforeTargets="Restore">
    <Message Text="Restoring dotnet tools" Importance="High" />
    <Exec Command="dotnet tool restore" />
  </Target>
  <Import Project="..\Shared\Scene.props" />
</Project>
