<Project>
  <!--
    Imported by every sample that draws Scene: the source, the embedded SVG it loads, and the SVG
    parser. Svg.Skia 5.2+ is the first line built on SkiaSharp 4.x (5.1.1 was the last on 3.119).
  -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Scene.cs" Link="Scene.cs" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)Drop.svg" LogicalName="SampleShared.Drop.svg" Link="Drop.svg" />
    <PackageReference Include="Svg.Skia" Version="5.2.3" />
  </ItemGroup>
</Project>
