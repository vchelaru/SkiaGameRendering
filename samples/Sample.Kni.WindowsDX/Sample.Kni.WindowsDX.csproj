<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\eng\Versions.props" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <KniPlatform>WindowsDX</KniPlatform>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Icon.ico" />
    <None Remove="Icon.bmp" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Icon.ico" />
    <EmbeddedResource Include="Icon.bmp" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="nkast.Xna.Framework" Version="[$(KniVersion)]" />
    <PackageReference Include="nkast.Xna.Framework.Content" Version="[$(KniVersion)]" />
    <PackageReference Include="nkast.Xna.Framework.Graphics" Version="[$(KniVersion)]" />
    <PackageReference Include="nkast.Xna.Framework.Audio" Version="[$(KniVersion)]" />
    <PackageReference Include="nkast.Xna.Framework.Media" Version="[$(KniVersion)]" />
    <PackageReference Include="nkast.Xna.Framework.Input" Version="[$(KniVersion)]" />
    <PackageReference Include="nkast.Xna.Framework.Game" Version="[$(KniVersion)]" />
    <PackageReference Include="nkast.Xna.Framework.Devices" Version="[$(KniVersion)]" />
    <PackageReference Include="nkast.Xna.Framework.Storage" Version="[$(KniVersion)]" />
    <PackageReference Include="nkast.Kni.Platform.WinForms.DX11" Version="[$(KniVersion)]" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\SkiaGameRendering.Kni.WindowsDX\SkiaGameRendering.Kni.WindowsDX.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Sample.MonoGame.DesktopGL\Game1.cs" Link="Game1.cs" />
  </ItemGroup>
</Project>
