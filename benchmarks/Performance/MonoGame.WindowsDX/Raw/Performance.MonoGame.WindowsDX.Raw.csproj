<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RollForward>Major</RollForward>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>..\..\app.manifest</ApplicationManifest>
    <RootNamespace>Performance</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8.5.1" />
    <PackageReference Include="Apos.Shapes" Version="0.8.6" />
    <PackageReference Include="FontStashSharp.MonoGame" Version="1.6.2" />
    <PackageReference Include="StbTrueTypeSharp" Version="1.26.13" />
  </ItemGroup>
  <!-- The Raw and Skia apps share the scenes and the loop; Raw adds the engine-side drawing (SpriteBatch, Apos.Shapes, fonts). -->
  <Import Project="..\..\Shared\Performance.Shared.props" />
  <ItemGroup>
    <Compile Include="..\..\Shared\Engine\*.cs" Link="Shared\Engine\%(Filename)%(Extension)" />
    <Compile Include="..\GpuInfo.cs" Link="GpuInfo.cs" />
  </ItemGroup>
</Project>
