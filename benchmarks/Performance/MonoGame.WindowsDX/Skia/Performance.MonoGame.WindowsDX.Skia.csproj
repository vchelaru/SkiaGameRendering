<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RollForward>Major</RollForward>
    <ApplicationManifest>..\..\app.manifest</ApplicationManifest>
    <RootNamespace>Performance</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8.5.1" />
    <PackageReference Include="Svg.Skia" Version="5.2.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\SkiaGameRendering.WindowsDX\SkiaGameRendering.WindowsDX.csproj" />
  </ItemGroup>
  <!-- The Raw and Skia apps share the scenes and the loop; Skia adds the pure SKCanvas drawing. -->
  <Import Project="..\..\Shared\Performance.Shared.props" />
  <ItemGroup>
    <Compile Include="..\..\Shared\Skia\*.cs" Link="Shared\Skia\%(Filename)%(Extension)" />
    <Compile Include="..\GpuInfo.cs" Link="GpuInfo.cs" />
  </ItemGroup>
</Project>
