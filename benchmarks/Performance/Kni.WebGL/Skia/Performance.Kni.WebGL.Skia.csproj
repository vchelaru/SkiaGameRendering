<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <Import Project="..\..\..\..\eng\Versions.props" />
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <KniPlatform>BlazorGL</KniPlatform>
    <BlazorEnableTimeZoneSupport>false</BlazorEnableTimeZoneSupport>
    <WasmBuildNative>true</WasmBuildNative>
    <RootNamespace>Performance</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="nkast.Kni.Platform.Blazor.GL" Version="$(KniVersion)" />
    <PackageReference Include="Svg.Skia" Version="5.2.3" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.27" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.27" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\SkiaGameRendering.Kni.WebGL\SkiaGameRendering.Kni.WebGL.csproj" />
  </ItemGroup>
  <!-- The Raw and Skia apps share the scenes and the loop; Skia adds the pure SKCanvas drawing. -->
  <Import Project="..\..\Shared\Performance.Shared.props" />
  <ItemGroup>
    <Compile Include="..\..\Shared\Skia\*.cs" Link="Shared\Skia\%(Filename)%(Extension)" />
    <Compile Include="..\GpuInfo.cs" Link="GpuInfo.cs" />
    <Compile Include="..\PerfPage.cs" Link="PerfPage.cs" />
  </ItemGroup>
</Project>
