<Project>
  <!-- What every MonoGame and KNI performance app compiles in: the core plus the XNA host (PerfGame). -->
  <Import Project="$(MSBuildThisFileDirectory)Performance.Core.props" />
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Xna\PerfGame.cs" Link="Shared\Xna\PerfGame.cs" />
  </ItemGroup>
</Project>
