<Project>
  <!-- The engine-agnostic core every performance app compiles in: scenes, assets, the measure loop
       (PerfRunner) and the results file. No engine types; each host adds its own window and frame loop. -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)*.cs" Link="Shared\%(Filename)%(Extension)" />
    <Compile Include="$(MSBuildThisFileDirectory)Assets\*.cs" Link="Shared\Assets\%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\..\samples\Sample.Gum.Kni.WebGL\Assets\NotoSans.ttf" LogicalName="Performance.NotoSans.ttf" Link="Shared\Assets\NotoSans.ttf" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\..\samples\Shared\Drop.svg" LogicalName="Performance.Icon.svg" Link="Shared\Assets\Icon.svg" />
  </ItemGroup>
</Project>
