<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <Import Project="..\..\eng\Versions.props" />
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <KniPlatform>BlazorGL</KniPlatform>
    <BlazorEnableTimeZoneSupport>false</BlazorEnableTimeZoneSupport>
    <WasmBuildNative>true</WasmBuildNative>
    <!-- Not part of SkiaGameRendering.sln and not built by CI - this is a throwaway spike/benchmark
         (repo issue #12 Option A per-frame cost measurement), same status as the SpikeContextBridge
         work it's built from. Build directly: dotnet build benchmarks\Benchmarks.WebGLOptionA -c Release -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- SPIKE ONLY, temporary, not for commit upstream: points at a locally patched, locally built
         clone of kniEngine/kni (tag v4.3.9001 + GraphicsDevice.InvalidateStateCache, cloned to
         C:\kni-src - see WebGL-KNI-Integration.md section 6 and the worktree-agent-a366b823b701668f9
         spike) instead of the real NuGet package, because this benchmark calls the new
         GraphicsDevice.InvalidateStateCache() API that only exists on that patched build. If
         C:\kni-src is missing or its InvalidateStateCache patch has been reverted, re-apply it
         following WebGL-KNI-Integration.md section 6 before this project will build. -->
    <ProjectReference Include="C:\kni-src\Platforms\Kni.Platform.Blazor.GL.csproj" />
    <!-- <PackageReference Include="nkast.Kni.Platform.Blazor.GL" Version="$(KniVersion)" /> -->
  </ItemGroup>

  <ItemGroup>
    <!-- Same SkiaSharp packages SkiaGameRendering.Kni.WebGL uses - deliberately NOT a reference to
         that project itself. This benchmark bypasses the shipped Option D backend entirely (it is
         the thing being compared against), so it must not depend on or risk touching it. -->
    <PackageReference Include="SkiaSharp" Version="[$(SkiaSharpVersion)]" />
    <PackageReference Include="SkiaSharp.Views.Blazor" Version="[$(SkiaSharpVersion)]" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.27" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.27" PrivateAssets="all" />
  </ItemGroup>
</Project>
