@page "/"
@page "/index.html"
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Option A per-frame cost (indicative)</PageTitle>

<main id="shell">
    <h1>WebGL Option A vs Option D - live per-frame cost (indicative)</h1>
    <p>
        Runs BOTH architectures back-to-back, interleaved frame-by-frame, in this same page load -
        Option A (GraphicsDevice.InvalidateStateCache() + a Skia draw into KNI's shared WebGL2
        context + KNI's own next draw call) and Option D (Skia draws to its own separate canvas,
        then a cross-context texSubImage2D blit into a KNI texture - this repo's actual shipped
        architecture). Interleaving both every frame means both see identical power/thermal
        conditions in this session, unlike comparing a live run against
        docs/webgl/performance-results.md's static baseline (captured a different day, possibly a
        different power state - that baseline is still shown below for historical context).
    </p>
    <p>
        Resolution: @_width x @_height.
        <a href="?w=1920&amp;h=1080">1920x1080</a> |
        <a href="?w=2560&amp;h=1440">2560x1440</a> |
        <a href="?w=3840&amp;h=2160">3840x2160</a>
        - one resolution per page load: KNI's BlazorGL platform has no working live-resize
        (ChangeClientSize is a no-op stub in kniEngine/kni v4.3.9001), so switching resolution
        reloads the page. Also see README.md before trusting any number this page reports -
        headless/CI runs are correctness signals only.
    </p>
    <p>Option A (shared context, drawn via KNI's own canvas below):</p>
    <canvas id="theCanvas" width="@_width" height="@_height"></canvas>
    <p>Option D (Skia's own separate canvas, blitted into a KNI texture each frame):</p>
    <canvas id="option-d-source-canvas" width="@_width" height="@_height"></canvas>
    <div id="controls">
        <button id="run" disabled>Run this resolution</button>
        <button id="export" disabled>Export</button>
    </div>
    <pre id="report">@_status</pre>
    <section id="comparison" aria-live="polite"></section>
</main>

@code {
    private int _width = 1920;
    private int _height = 1080;

    protected override void OnInitialized()
    {
        var query = new Uri(Nav.Uri).Query.TrimStart('?');
        foreach (var pair in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = pair.Split('=', 2);
            if (parts.Length != 2 || !int.TryParse(parts[1], out var value) || value <= 0)
                continue;
            if (parts[0] == "w") _width = value;
            else if (parts[0] == "h") _height = value;
        }
    }
}
