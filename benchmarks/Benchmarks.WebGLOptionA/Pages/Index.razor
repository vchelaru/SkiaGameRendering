@page "/"
@page "/index.html"
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Option A per-frame cost (indicative)</PageTitle>

<main id="shell">
    <h1>WebGL Option A per-frame cost - indicative benchmark</h1>
    <p>
        Measures GraphicsDevice.InvalidateStateCache() + a Skia draw into KNI's shared WebGL2
        context + KNI's own next draw call, per frame, at this page's resolution
        (@_width x @_height - pass ?w=&amp;h= to change it, see README.md). One resolution per page
        load: KNI's BlazorGL platform has no working live-resize (ChangeClientSize is a no-op stub
        in kniEngine/kni v4.3.9001), so the 3-resolution matrix is 3 separate page loads, not one
        in-session resize loop. Also see README.md before trusting any number this page reports -
        headless/CI runs are correctness signals only.
    </p>
    <canvas id="theCanvas" width="@_width" height="@_height"></canvas>
    <div id="controls">
        <button id="run" disabled>Run this resolution</button>
        <button id="export" disabled>Export</button>
    </div>
    <pre id="report">@_status</pre>
    <section id="comparison" aria-live="polite"></section>
</main>

@code {
    private int _width = 1920;
    private int _height = 1080;

    protected override void OnInitialized()
    {
        var query = new Uri(Nav.Uri).Query.TrimStart('?');
        foreach (var pair in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = pair.Split('=', 2);
            if (parts.Length != 2 || !int.TryParse(parts[1], out var value) || value <= 0)
                continue;
            if (parts[0] == "w") _width = value;
            else if (parts[0] == "h") _height = value;
        }
    }
}
