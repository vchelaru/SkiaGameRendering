<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\eng\Versions.props" />

  <PropertyGroup>
    <!--
      Windows-only TFM like Stride.D3D11. This project never sets StrideGraphicsApi itself: it reaches
      every D3D12 member of Stride.Graphics by reflection (see SkiaStrideD3D12Context), so it compiles
      against whichever Stride.Graphics.dll variant restore picks, and the consuming game's
      StrideGraphicsApi=Direct3D12 decides which one runs.
    -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageId>SkiaGameRendering.Stride.D3D12</PackageId>
    <!-- Prerelease for the same reason as SkiaGameRendering.Stride.D3D11: Stride 4.4.0-beta5 is one (NU5104). -->
    <Version>$(LibraryVersion)-beta</Version>
    <Description>GPU SkiaSharp rendering into Stride Texture targets via Skia's Direct3D 12 backend on Stride's own device and queue, with zero-copy GPU texture sharing.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <RepositoryUrl>https://github.com/vchelaru/SkiaGameRendering</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Stride.Engine" Version="$(StrideVersion)" />
    <!--
      Stride.Graphics already depends on these, but this project names their ComPtr types directly
      when unboxing the reflected members, so the versions are pinned to Stride's own (SilkNetVersion).
      A direct reference also keeps Stride's StrideGraphicsApi package filter from stripping them.
    -->
    <PackageReference Include="Silk.NET.Direct3D12" Version="$(SilkNetVersion)" />
    <PackageReference Include="Silk.NET.DXGI" Version="$(SilkNetVersion)" />
    <PackageReference Include="Silk.NET.Core" Version="$(SilkNetVersion)" />
    <PackageReference Include="SkiaSharp" Version="[$(SkiaSharpVersion)]" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SkiaGameRendering.Core.D3D12\SkiaGameRendering.Core.D3D12.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
