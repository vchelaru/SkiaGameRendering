<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\eng\Versions.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageId>SkiaGameRendering.Brutal</PackageId>
    <Version>$(LibraryVersion)</Version>
    <!-- Takes raw Vulkan handles (IntPtr), so it has no dependency on any BRUTAL package: BRUTAL's wrappers expose
         them as VkHandle, and a BRUTAL version bump cannot break this package. -->
    <Description>GPU SkiaSharp rendering into a Vulkan image for BRUTAL apps (Vulkan 1.3, Windows and Linux), with no CPU readback.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <RepositoryUrl>https://github.com/vchelaru/SkiaGameRendering</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="[$(SkiaSharpVersion)]" />
    <!-- The main SkiaSharp package only carries Windows/macOS native assets implicitly; BRUTAL runs on Linux. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="[$(SkiaSharpVersion)]" />
    <ProjectReferenceInclude="..\SkiaGameRendering.Core.VK\SkiaGameRendering.Core.VK.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
