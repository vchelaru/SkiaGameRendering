<Project>
  <!--
    Imported by an app that references SkiaGameRendering.Raylib.WebGL (NuGet puts this file in build/ and
    buildTransitive/; the in-repo sample imports it by path). raylib itself comes from Raylib-cs 8.1.0, whose
    buildTransitive targets link its browser-wasm raylib.a (with -sUSE_GLFW=3) into dotnet.native.wasm when the
    app's RuntimeIdentifier is browser-wasm, next to SkiaSharp. This file adds the pre-js and WebGL 2 link flags.
    Needs the .NET 10 wasm-tools workload.
  -->
  <PropertyGroup>
    <SkiaRaylibNativeDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', 'native'))</SkiaRaylibNativeDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UsingMicrosoftNETSdkBlazorWebAssembly)' == 'true' or '$(UsingMicrosoftNETSdkWebAssembly)' == 'true'">
    <WasmBuildNative>true</WasmBuildNative>
    <EmccExtraLDFlags>$(EmccExtraLDFlags) --pre-js &quot;$(SkiaRaylibNativeDir)skia-raylib-webgl.js&quot;</EmccExtraLDFlags>
  </PropertyGroup>
</Project>
