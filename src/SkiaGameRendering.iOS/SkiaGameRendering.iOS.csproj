<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\eng\Versions.props" />
  <PropertyGroup>
    <!-- MonoGame.Framework.iOS ships net8.0-ios18.0, but SkiaSharp's iOS native assets need net10.0-ios26.0. -->
    <TargetFramework>net10.0-ios26.0</TargetFramework>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>SkiaGameRendering</RootNamespace>
    <PackageId>SkiaGameRendering.iOS</PackageId>
    <Version>$(LibraryVersion)</Version>
    <Description>GPU SkiaSharp rendering into MonoGame iOS (OpenGL ES) Texture2D targets, with zero-copy GPU texture sharing.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <RepositoryUrl>https://github.com/vchelaru/SkiaGameRendering</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.iOS" Version="3.8.4.1" />
    <PackageReference Include="SkiaSharp" Version="[$(SkiaSharpVersion)]" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SkiaGameRendering.Core.OGL\SkiaGameRendering.Core.OGL.csproj" />
  </ItemGroup>

  <!-- Shared core files from the MonoGame DesktopGL project -->
  <ItemGroup>
    <Compile Include="..\SkiaGameRendering\SkiaBackend.cs" Link="Core\SkiaBackend.cs" />
    <Compile Include="..\SkiaGameRendering\SkiaSharedGlBackend.cs" Link="Core\SkiaSharedGlBackend.cs" />
    <Compile Include="..\SkiaGameRendering\SkiaRenderer.cs" Link="Core\SkiaRenderer.cs" />
    <Compile Include="..\SkiaGameRendering\SkiaTarget.cs" Link="Core\SkiaTarget.cs" />
    <Compile Include="..\SkiaGameRendering\SkiaRenderTarget2D.cs" Link="Core\SkiaRenderTarget2D.cs" />
    <Compile Include="..\SkiaGameRendering\SkiaDirectCanvas.cs" Link="Core\SkiaDirectCanvas.cs" />
    <Compile Include="..\SkiaGameRendering\MonoGameBoundRenderTarget.cs" Link="Core\MonoGameBoundRenderTarget.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
