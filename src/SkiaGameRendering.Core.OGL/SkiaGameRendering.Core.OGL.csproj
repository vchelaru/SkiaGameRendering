<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\eng\Versions.props" />
  <PropertyGroup>
    <!-- netstandard2.1 is for Unity, whose Mono runtime can't load a net8.0 assembly (issue #95). -->
    <TargetFrameworks>net8.0;netstandard2.1</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageId>SkiaGameRendering.Core.OGL</PackageId>
    <Version>$(LibraryVersion)</Version>
    <Description>Engine-agnostic raw-GL/Skia FBO interop shared by GL-based SkiaGameRendering backends (DesktopGL today; other GL-based engines in the future). Not meant to be referenced directly - installed automatically as a dependency of SkiaGameRendering.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <RepositoryUrl>https://github.com/vchelaru/SkiaGameRendering</RepositoryUrl>
  </PropertyGroup>

  <!-- This one loads native libraries through NativeLibrary, which netstandard2.1 lacks. Unity doesn't use it yet. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <Compile Remove="CglSharedContext.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="[$(SkiaSharpVersion)]" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
