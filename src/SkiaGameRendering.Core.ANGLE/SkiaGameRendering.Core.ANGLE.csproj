<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\eng\Versions.props" />
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageId>SkiaGameRendering.Core.ANGLE</PackageId>
    <Version>$(LibraryVersion)</Version>
    <Description>Engine-agnostic ANGLE/D3D11-Skia interop shared by D3D11-based SkiaGameRendering backends (MonoGame WindowsDX, KNI WindowsDX). Not meant to be referenced directly - installed automatically as a dependency of those backends.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <RepositoryUrl>https://github.com/vchelaru/SkiaGameRendering</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="[$(SkiaSharpVersion)]" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE.md" Pack="true" PackagePath="\" />
    <!-- ANGLE is BSD-3-Clause; binary redistribution requires carrying its copyright notice,
         conditions and disclaimer as package content (issue #36). -->
    <None Include="ANGLE-LICENSE.txt" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    ANGLE's libEGL.dll/libGLESv2.dll are checked in directly under runtimes/<rid>/native (~12 MB
    total for both RIDs) rather than downloaded at build/pack time - see eng/vendor-angle.ps1 and
    eng/angle-provenance.json. They're built from source via vcpkg, which is a real multi-minute
    compile requiring the MSVC C++ toolchain, so unlike Tests.Core.OGL's mesa-vendor/ (a same-day
    prebuilt download) this can't reasonably be a build/pack-time step - it's a maintainer-run
    script instead, and the output is small enough to just commit.
  -->
  <ItemGroup>
    <None Include="runtimes\win-x64\native\libEGL.dll" Pack="true" PackagePath="runtimes\win-x64\native\libEGL.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="runtimes\win-x64\native\libGLESv2.dll" Pack="true" PackagePath="runtimes\win-x64\native\libGLESv2.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="runtimes\win-arm64\native\libEGL.dll" Pack="true" PackagePath="runtimes\win-arm64\native\libEGL.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="runtimes\win-arm64\native\libGLESv2.dll" Pack="true" PackagePath="runtimes\win-arm64\native\libGLESv2.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
