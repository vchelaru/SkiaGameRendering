<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\eng\Versions.props" />
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>SkiaGameRendering</RootNamespace>
    <PackageId>SkiaGameRendering.Fna.WindowsDX</PackageId>
    <Version>$(LibraryVersion)</Version>
    <Description>GPU SkiaSharp rendering into FNA Texture2D targets via ANGLE on FNA3D's D3D11 driver, with zero-copy GPU texture sharing. Requires FNA3D_FORCE_DRIVER=D3D11.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <RepositoryUrl>https://github.com/vchelaru/SkiaGameRendering</RepositoryUrl>
    <!-- SkiaBackend.cs shares one source with MonoGame/KNI; FNA has no SurfaceFormat.Bgra32. -->
    <DefineConstants>$(DefineConstants);FNA</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="[$(SkiaSharpVersion)]" />
  </ItemGroup>

  <!--
    FNA isn't on NuGet: the FNA way is a submodule plus a ProjectReference to FNA.Core.csproj, so
    that's how this builds too (external/FNA, pinned to a release tag). PrivateAssets="All" keeps FNA
    out of the package's dependency list - a consumer brings their own FNA, and this assembly binds
    to it by name ("FNA") at runtime, the same arrangement Gum.FNA uses.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\external\FNA\FNA.Core.csproj" PrivateAssets="All" />
    <ProjectReference Include="..\SkiaGameRendering.Core.ANGLE\SkiaGameRendering.Core.ANGLE.csproj" />
  </ItemGroup>

  <!-- Shared core files from the DesktopGL project -->
  <ItemGroup>
    <Compile Include="..\SkiaGameRendering\SkiaBackend.cs" Link="SkiaBackend.cs" />
    <Compile Include="..\SkiaGameRendering\SkiaRenderer.cs" Link="SkiaRenderer.cs" />
    <Compile Include="..\SkiaGameRendering\SkiaRenderTarget2D.cs" Link="SkiaRenderTarget2D.cs" />
    <Compile Include="..\SkiaGameRendering\SkiaTarget.cs" Link="SkiaTarget.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
