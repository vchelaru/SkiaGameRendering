<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\eng\Versions.props" />
  <PropertyGroup>
    <!-- netstandard2.1 is for Unity, whose Mono runtime can't load a net8.0 assembly. -->
    <TargetFrameworks>net8.0;netstandard2.1</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageId>SkiaGameRendering.Core.VK</PackageId>
    <Version>$(LibraryVersion)</Version>
    <Description>Engine-agnostic Vulkan/Skia interop shared by Vulkan-based SkiaGameRendering backends (Stride on Linux/macOS today). Not meant to be referenced directly - installed automatically as a dependency of those backends.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <RepositoryUrl>https://github.com/vchelaru/SkiaGameRendering</RepositoryUrl>
  </PropertyGroup>

  <!-- Unity's netstandard2.1 build only wraps the host's image, so it leaves out the helpers that create and
       transition images through function pointers. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <Compile Remove="VkImageAllocator.cs;VkImageLayoutTransitioner.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="[$(SkiaSharpVersion)]" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
